{
  "compilerOptions": {
    // Composite project (in the root references) so the whole client is
    // type-checked under its own DOM lib — notably the bridge, which needs
    // `window` and is imported by no Node consumer. Code a Node package imports
    // via `./dev` is additionally checked inline under that consumer's config, so
    // shared code there must use only globals common to DOM and Node.
    "composite": true,

    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
