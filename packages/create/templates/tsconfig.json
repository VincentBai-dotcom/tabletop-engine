{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@tableverse-kit/engine": ["../../engine/src/index.ts"],
      "@tableverse-kit/config": ["../../config/src/index.ts"],
      "@tableverse-kit/client": ["../../client/src/index.ts"],
      "@tableverse-kit/client/dev": ["../../client/src/dev/index.ts"],
      "{{projectName}}-engine": ["./default/engine/src/index.ts"]
    }
  },
  "include": ["default/**/*.ts", "env.d.ts"]
}
